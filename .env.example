# ProofPay Environment Variables
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./proofpay.db
# For PostgreSQL: postgresql+asyncpg://proofpay:proofpay_password@localhost:5432/proofpay

# PayPal Sandbox Configuration (Strictly 6 Endpoints)
PAYPAL_MODE=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_WEBHOOK_ID=your_sandbox_webhook_id

# AI & LLM Provider
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
