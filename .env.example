# ProofPay Environment Variables
ENVIRONMENT=development
DEBUG=false
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
WORKSPACE_PRINCIPAL_LIMIT_CENTS=1000000
PROOFPAY_DB_PORT=5432
PROOFPAY_API_PORT=8000
PROOFPAY_FIXTURE_PORT=8080
PROOFPAY_WEB_PORT=3000

# Public local-development examples only. Replace every key/code for deployment.
# Outside development/test, cookies must be Secure and served over HTTPS.
SESSION_CSRF_KEY=local-only-session-key-change-before-deployment
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
DEMO_JUDGE_ACCESS_CODE=local-judge-access
DEMO_OWNER_ACCESS_CODE=local-owner-access
DEMO_MAYA_ACCESS_CODE=local-maya-access
DEMO_LEO_ACCESS_CODE=local-leo-access
WORKER_LEASE_SECONDS=120
WORKER_HEARTBEAT_SECONDS=20
RUNNER_SERVICE_TOKEN=local-only-runner-service-key-change-before-deployment
RUNNER_LEASE_SECONDS=90
RUNNER_MAX_ATTEMPTS=3

# Database
DATABASE_URL=postgresql+asyncpg://proofpay_api:local_api_only@localhost:5432/proofpay
# These example passwords are for local Compose only. Use generated, URL-encoded
# deployment secrets and run provisioning/migrations as separate one-shot jobs.
PROOFPAY_MIGRATOR_PASSWORD=local_migration_only
PROOFPAY_API_PASSWORD=local_api_only
PROOFPAY_EXECUTOR_PASSWORD=local_executor_only
# Supply MIGRATION_DATABASE_URL only to migration jobs/shells, never the API.
# MIGRATION_DATABASE_URL=postgresql+psycopg://proofpay_migrator:local_migration_only@localhost:5432/proofpay

# Financial credentials belong in the separate .env.executor (not the API/runner).
# The guarded executor workflow is not implemented yet.

# AI & LLM Provider
LLM_PROVIDER=unconfigured
LLM_TIMEOUT_SECONDS=45
LLM_MAX_CALLS_PER_STAGE=2
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
# Optional attribution headers for OpenRouter requests.
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=ProofPay
